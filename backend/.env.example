PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/borrowbox
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Public URL baked into handover QR codes. Use your LAN IP for phone testing:
# PUBLIC_APP_URL=http://192.168.1.10:5173
# For production use the HTTPS domain, e.g. https://borrowbox.example.com
PUBLIC_APP_URL=http://localhost:5173
HANDOVER_TTL=15m
UPLOAD_DIR=uploads